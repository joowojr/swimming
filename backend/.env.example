# Spring profile
SPRING_PROFILES_ACTIVE=local

# PostgreSQL / Amazon RDS
DB_URL=jdbc:postgresql://<rds-endpoint>:5432/<database>?sslmode=verify-full&sslrootcert=/application/rds-ca.pem
DB_USERNAME=<application-user>
DB_PASSWORD=<secret>

# Application authentication
JWT_SECRET=<random-secret-at-least-32-bytes>
ALLOWED_ORIGINS=https://www.example.com
GOOGLE_CLIENT_ID=<google-web-client-id>.apps.googleusercontent.com

# External services
OPENAI_API_KEY=<secret>
PLACE_CDN_BASE_URL=https://cdn.example.com
# 공공데이터포털 한국천문연구원 특일 정보 API의 Encoding 인증키
KASI_HOLIDAY_SERVICE_KEY=

# Prompt path. Spring resource location - the prefix picks the store.
#   classpath:prompts/task-organizer-v4.md          bundled default (leave unset)
#   file:/opt/swimming/prompts/task-organizer.md    edit without rebuilding the image
TASK_ORGANIZER_PROMPT_PATH=
