flowchart TD

    USER["Internet Users"]
    DNS["External DNS Provider<br/>내도메인.한국<br/><br/>app.example.com<br/>api.example.com<br/>future: dev.example.com"]

    subgraph EDGE["AWS Edge"]
        CF["CloudFront Distribution<br/>swimming-prod-web-cdn"]
        ACM["ACM Certificate<br/>swimming-prod-web-cert<br/>us-east-1"]
    end

    S3["S3 Bucket<br/>swimming-prod-web<br/>Block Public Access = ON"]

    subgraph VPC["VPC<br/>swimming-prod-vpc<br/>10.0.0.0/16"]

        IGW["Internet Gateway<br/>swimming-prod-igw"]

        subgraph PUBLIC["Public Subnet A<br/>swimming-prod-public-a<br/>10.0.1.0/24"]

            NGINX_EIP["Elastic IP<br/>swimming-prod-nginx-eip"]

            NGINX["EC2<br/>swimming-prod-nginx<br/>Nginx :443<br/>Let's Encrypt"]

            NAT_EIP["Elastic IP<br/>swimming-prod-nat-eip"]

            NAT["EC2 NAT Instance<br/>swimming-prod-nat<br/>Source/Dest Check = OFF"]
        end

        subgraph APP["Private App Subnet A<br/>swimming-prod-app-a<br/>10.0.11.0/24"]

            SPRING["EC2<br/>swimming-prod-api<br/>Spring Boot :8080<br/>No Public IPv4"]

            API_ROLE["IAM Instance Role<br/>swimming-prod-api-role"]
        end

        subgraph DBNET["Private DB Subnets"]

            DBA["DB Subnet A<br/>swimming-prod-db-a<br/>10.0.21.0/24"]

            DBC["DB Subnet C<br/>swimming-prod-db-c<br/>10.0.22.0/24"]

            RDS["RDS PostgreSQL<br/>swimming-prod-db<br/>Public Access = false<br/>Encrypted"]
        end

        subgraph FUTURE["Future Private AI"]

            BRVPCE["Interface VPC Endpoint<br/>swimming-prod-bedrock-runtime-vpce<br/>Private DNS = ON"]

        end
    end

    GOOGLE["Google OAuth<br/>External HTTPS API"]

    BEDROCK["Amazon Bedrock Runtime"]

    USER --> DNS

    DNS -->|"app.example.com"| CF
    CF -->|"OAC signed request"| S3
    ACM --- CF

    DNS -->|"api.example.com → EIP"| NGINX_EIP
    NGINX_EIP --> NGINX

    IGW --- PUBLIC

    NGINX -->|"TCP 8080<br/>Private IP only"| SPRING

    API_ROLE --- SPRING

    SPRING -->|"TCP 5432"| RDS

    SPRING -->|"Default Route<br/>External HTTPS only"| NAT
    NAT --> NAT_EIP
    NAT_EIP --> IGW
    IGW --> GOOGLE

    SPRING -.->|"HTTPS 443"| BRVPCE
    BRVPCE -.->|"AWS PrivateLink"| BEDROCK